# Public build-time configuration only. Never put secrets in VITE_* values.
# Use the API origin, without /api/v1; the client appends that path.
#
# IMPORTANT: use the same hostname as the frontend dev server (localhost, not
# 127.0.0.1). Mixing the two means the browser treats them as different origins
# and will not send the racepass_csrf cookie back to the API, causing 403s on
# every login/register/logout attempt (SameSite=Lax blocks cross-site POSTs).
VITE_API_URL=http://localhost:8010
# Use a browser-restricted Google Maps JavaScript API key for the optional organizer location picker.
VITE_GOOGLE_MAPS_API_KEY=
