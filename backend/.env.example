# Copy to a secret-managed environment; never commit real values.
ENVIRONMENT=production
AUTO_MIGRATE=false
# Temporary emergency fallback only when the host has no release command:
# set both this and AUTO_MIGRATE=true for one deploy, then turn them off.
ALLOW_STARTUP_MIGRATIONS=false
PORT=8000

# Standard PostgreSQL connection URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Exact browser origin(s), comma-separated. Do not use a trailing slash.
FRONTEND_ORIGINS=https://frontend-placeholder.example

SESSION_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
TICKET_SIGNING_SECRET=replace-with-a-third-long-random-secret

# Configure only when Google sign-in is enabled.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api-placeholder.example/api/v1/auth/google/callback

# Communication encryption key (for encrypting sensitive credentials like app passwords)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production for credential security.
COMMUNICATION_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Private S3-compatible object storage. Keep the bucket private.
STORAGE_MODE=s3
STORAGE_ENDPOINT=https://s3-compatible-placeholder.example
STORAGE_BUCKET=racepass-private
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=replace-with-storage-access-key
STORAGE_SECRET_KEY=replace-with-storage-secret-key
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=2000000
STORAGE_MAX_DIMENSION=4096

# Gmail API (separate from Google sign-in); see GMAIL_API_SETUP.md
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Clerk authentication (required when CLERK_AUTH_REQUIRED=true)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:8080
CLERK_AUTH_REQUIRED=false
